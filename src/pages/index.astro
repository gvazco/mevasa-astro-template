---
import Layout from '@/layouts/Layout.astro';
import SalesGrid from '@/components/ui/SalesGrid.astro';
import CtaAction from '@/components/ui/CtaAction.astro';

import { DirectusPageIndexResponseSchema } from '@/types';
const newUrl = `${import.meta.env.API_ITEMS}/pages?filter[slug][_eq]=inicio&fields=*,left_category.*,center_category.*,right_category.*`;
const newResponse = await fetch(newUrl);
const newJson = await newResponse.json();
const newData = DirectusPageIndexResponseSchema.parse(newJson);
const { data: pageIndex } = newData;
const publicAssetsUrl = import.meta.env.PUBLIC_ASSETS;
---

<Layout
  title="Especialistas en lámina de acero"
  subtitle={pageIndex[0]?.subtitle ||
    'Tu proveedor confiable de lámina de acero y accesorios'}
  bgImage={`${publicAssetsUrl}/${pageIndex[0]?.cover_image}`}
>
  <div
    class="text-center text-lg mt-1 font-medium text-gray-700 text-balance"
    set:html={pageIndex[0]?.content}
  />
  <SalesGrid />
  <CtaAction />
</Layout>
