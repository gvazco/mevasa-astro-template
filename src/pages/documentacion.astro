---
import Layout from '@/layouts/Layout.astro';
import BlogPosts from '@/components/documentacion/BlogPosts.astro';
import PostCategories from '@/components/ui/PostCategories.astro';
import { DirectusPageResponseSchema } from '@/types';
const url = `${import.meta.env.API_ITEMS}/pages?filter[slug][_eq]=documentacion`;
const response = await fetch(url);
const json = await response.json();
const data = DirectusPageResponseSchema.parse(json);
const { data: pageData } = data;
---

<Layout
  title={pageData[0]?.title}
  subtitle={pageData[0]?.subtitle || ''}
  bgImage={`${import.meta.env.PUBLIC_ASSETS}/${pageData[0]?.cover_image}`}
>
  <div
    class="text-lg sm:text-xl space-y-3 mt-2 sm:mt-10 lg:mt-0 line-clamp-5 md:line-clamp-none"
    set:html={pageData[0]?.content}
  />
  <PostCategories />
  <BlogPosts />
</Layout>
