---
import {
  DirectusArticlesResponseSchema,
  DirectusCategoriesSlugSchema,
  DirectusCategorySchema,
} from '@/types';
import Layout from '@/layouts/Layout.astro';
import PostCategories from '@/components/ui/PostCategories.astro';
import PostCard from '@/components/documentacion/PostCard.astro';

export async function getStaticPaths() {
  const res = await fetch(`${import.meta.env.API_ITEMS}/articles_categories`);
  const json = await res.json();
  const categories = DirectusCategoriesSlugSchema.parse(json.data);
  return categories.map((category) => ({
    params: { slug: category.slug },
  }));
}

const { slug } = Astro.params;
const newCatUrl = `${import.meta.env.API_ITEMS}/articles_categories?filter[slug][_eq]=${slug}`;
const catRes = await fetch(newCatUrl);
const catJson = await catRes.json();
const category = DirectusCategorySchema.parse(catJson.data[0]);

const postsUrl = `${import.meta.env.API_ITEMS}/articles?filter[category][_eq]=${category.id}&fields=*,category.*,tags.*,author.*`;
const postsRes = await fetch(postsUrl);
const postsJson = await postsRes.json();
const posts = DirectusArticlesResponseSchema.parse(postsJson);
const { data: postCategory } = posts;
---

<Layout
  title={`Posts en la categoría: ${postCategory[0]?.category?.name}`}
  subtitle={`Posts en la categoría: ${postCategory[0]?.category?.name}`}
  bgImage={`${import.meta.env.PUBLIC_ASSETS}/${postCategory[0]?.cover_image}`}
>
  <PostCategories />
  {postCategory.map((post) => <PostCard post={post} />)}
</Layout>
|
