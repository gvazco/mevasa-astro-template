---
import Layout from '@/layouts/Layout.astro';
import AboutGallery from '@/components/gallery/AboutGallery.astro';
import { Picture } from 'astro:assets';
import { DirectusPageResponseSchema } from '@/types';
const newUrl = `${import.meta.env.API_ITEMS}/pages?filter[slug][_eq]=nosotros`;
const newResponse = await fetch(newUrl);
const newJson = await newResponse.json();
const newData = DirectusPageResponseSchema.parse(newJson);
const { data: aboutPage } = newData;
---

<Layout
  title={aboutPage[0]?.title}
  subtitle={aboutPage[0]?.subtitle || ''}
  bgImage={`${import.meta.env.PUBLIC_ASSETS}/${aboutPage[0]?.cover_image}`}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-10">
    <div id="gallery">
      {
        aboutPage[0]?.cover_image && (
          <a
            href={`${import.meta.env.PUBLIC_ASSETS}/${aboutPage[0]?.cover_image}`}
            data-pswp-width={800}
            data-pswp-height={600}
          >
            <Picture
              src={`${import.meta.env.PUBLIC_ASSETS}/${aboutPage[0]?.cover_image}`}
              alt={aboutPage[0]?.title}
              width={800}
              height={600}
              formats={['avif', 'webp']}
            />
          </a>
        )
      }
      <AboutGallery />
    </div>

    <div class="text-xl space-y-3" set:html={aboutPage[0]?.content} />
  </div>
</Layout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();
  document.addEventListener('astro:after-swap', function () {
    lightbox.init();
  });
</script>
