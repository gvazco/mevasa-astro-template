---
import { Picture } from 'astro:assets';
import { type DirectusPageGalleryItem } from '@/types';
interface Props {
  gallery: DirectusPageGalleryItem[];
}

const { gallery } = Astro.props;
---

<div id="gallery" class="grid grid-cols-3 gap-3 mt-5">
  {
    gallery.map(
      (image) =>
        image?.id && (
          <a
            href={`${import.meta.env.PUBLIC_ASSETS}/${image.directus_files_id}`}
            data-pswp-width={800}
            data-pswp-height={600}
          >
            <Picture
              src={`${import.meta.env.PUBLIC_ASSETS}/${image.directus_files_id}`}
              alt="Galería de imágenes"
              width={800}
              height={600}
              formats={['avif', 'webp']}
            />
          </a>
        )
    )
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();
  document.addEventListener('astro:after-swap', function () {
    lightbox.init();
  });
</script>
