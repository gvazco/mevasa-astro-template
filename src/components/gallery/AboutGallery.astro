---
import GalleryGrid from '@/components/gallery/GalleryGrid.astro';
import { DirectusPageGalleryResponseSchema } from '@/types';
const newUrl = `${import.meta.env.API_ITEMS}/about_gallery?fields=about_gallery.*`;
const newResponse = await fetch(newUrl);
const newJson = await newResponse.json();
const newData = DirectusPageGalleryResponseSchema.parse(newJson);
---

<div>
  <GalleryGrid gallery={newData.data.about_gallery} />
</div>
