---
import { Picture } from 'astro:assets';
import type { Post } from '@/types';
import PostMeta from './PostMeta.astro';
import PostCategories from './PostCategories.astro';
import PostTags from './PostTags.astro';
interface Props {
  post: Post;
}
const { post } = Astro.props;
const { category, tags } = post;
---

<article
  class="grid grid-cols-1 lg:grid-cols-3 gap-5 py-10 border-b last-of-type:border-0 border-zinc-300"
>
  <div class="lg:col-span-2 space-y-5">
    <h3 class="text-coffee-900 font-black text-4xl uppercase">
      <a href={`/documentacion/${post?.slug}`}>
        {post?.title}
      </a>
    </h3>

    <PostMeta date={post?.date_created} />

    <PostCategories name={category?.name} slug={category?.slug} />

    <PostTags name={tags?.name} slug={tags?.slug} />

    <div set:html={post?.excerpt} class="line-clamp-2 text-lg" />
  </div>

  {
    post?.cover_image && (
      <Picture
        src={`${import.meta.env.PUBLIC_ASSETS}/${post.cover_image}`}
        alt={post?.title}
        width={800}
        height={600}
        formats={['avif', 'webp']}
        class="w-full lg:w-96 h-64 object-cover rounded-2xl"
      />
    )
  }
</article>
