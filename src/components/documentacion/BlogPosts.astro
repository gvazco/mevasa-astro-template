---
import { DirectusArticlesResponseSchema } from '@/types';
import PostCard from './PostCard.astro';
const newUrl = `${import.meta.env.API_ITEMS}/articles?fields=title,slug,cover_image,date_created,excerpt,status,category.*,tags.*,author.*`;
const newRes = await fetch(newUrl);
const newJson = await newRes.json();
const newData = DirectusArticlesResponseSchema.parse(newJson);
const { data: posts } = newData;
---

{posts.map((post) => <PostCard post={post} />)}
